{
	"name": "home-network",
	"version": "0.0.0",
	"private": true,
	"description": "Infrastructure as code for my UniFi home networks.",
	"type": "module",
	"scripts": {
		"check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"sync-provider": "pnpm --dir ../alchemy-unifi build && pnpm install",
		"prepare": "lefthook install && effect-tsgo patch"
	},
	"dependencies": {
		"@alchemy-unifi/network": "file:../alchemy-unifi/packages/network",
		"@alchemy.run/aws": "^2.0.0-beta.84",
		"@effect/platform-node": "^4.0.6",
		"alchemy": "^2.0.0-beta.84",
		"effect": "^4.0.6"
	},
	"devDependencies": {
		"@effect/tsgo": "^0.56.1",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^24.0.0",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"typescript": "7.1.0-beta"
	},
	"dependenciesMeta": {
		"@alchemy-unifi/network": {
			"injected": true
		}
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.15.0",
			"onFail": "download"
		}
	}
}
